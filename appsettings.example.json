{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Supabase": {
    "ProjectId": "YOUR_SUPABASE_PROJECT_ID",
    "ProjectName": "erpes-control-tower",
    "Region": "eu-central-1",
    "Url": "https://YOUR_SUPABASE_PROJECT_ID.supabase.co",
    "DatabaseHost": "db.YOUR_SUPABASE_PROJECT_ID.supabase.co",
    "PublishableKey": "YOUR_SUPABASE_PUBLISHABLE_KEY",
    "AnonKey": "YOUR_SUPABASE_ANON_KEY"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=controltower.db",
    "SupabaseConnection": "Host=db.YOUR_SUPABASE_PROJECT_ID.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "AllowedHosts": "*"
}
